# llama-cache.env — THE one place the model cache location is defined.
#
# Source this from anything that starts llama-server:
#
#     source "$SCRIPT_DIR/../llama-cache.env"
#
# WHY THIS FILE EXISTS. llama.cpp (build 10896, 0.4.0-dev) caches -hf downloads
# in the Hugging Face hub layout, models--<org>--<repo>/{blobs,refs,snapshots}.
# Where that tree lives is decided by, in order:
#
#     $LLAMA_CACHE            used directly as the root holding models--*
#     $HF_HOME                -> $HF_HOME/hub
#     $XDG_CACHE_HOME         -> $XDG_CACHE_HOME/huggingface/hub
#     (nothing)               -> ~/.cache/huggingface/hub    <- C:, and 93% full
#
# Both the unset and the LLAMA_CACHE roots have existed on the bench laptop at
# different times, which is why models have "re-downloaded themselves" without
# anyone deleting anything: llama-server was looking in the other one. Anything
# that changes the environment of the server process -- a scheduled task under a
# different account, a container, cmd.exe instead of Git Bash -- moves the root
# and silently re-downloads the roster.
#
# Setting it explicitly, from one file, is the fix. Do not hardcode this path
# anywhere else; source this instead.
#
# MUST BE A WINDOWS PATH. llama-server.exe is a native Windows binary and MSYS
# does not translate environment variables the way it translates command-line
# arguments, so "/d/llama-cache" would not resolve. Forward slashes are fine.

export LLAMA_CACHE="${LLAMA_CACHE:-D:/llama-cache}"

# The same directory in MSYS form, for shell-side checks (du, ls, find).
export LLAMA_CACHE_POSIX="${LLAMA_CACHE_POSIX:-/d/llama-cache}"
