{
  "testCommand": "python3 -m unittest discover -s tests -v",
  "testTimeoutSec": 60,
  "testFiles": [
    "tests/*.py"
  ],
  "testCountPattern": "^Ran (\\d+) tests?",
  "failurePattern": "^(?:FAIL|ERROR): (\\S+)",
  "minTests": 9,
  "checks": [
    {
      "name": "Python standard library only",
      "command": "python3 /opt/pi-small/workflow/checks/python_stdlib_only.py"
    }
  ]
}