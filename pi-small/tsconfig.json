{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"include": [
		"extensions/**/*.ts",
		"lib/**/*.ts",
		"test/**/*.ts",
		"workflow/**/*.ts"
	]
}
