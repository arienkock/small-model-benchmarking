{
	"name": "pi-small",
	"version": "0.1.0",
	"private": true,
	"description": "Pi plugin that owns the local llama-server stack for the small-model agent scaffold",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"check": "node check-roster.mjs",
		"test": "node test/plugin-test.ts && node test/serve-test.ts && node test/workflow-test.ts && node test/fix-loop-test.ts && node test/persona-test.ts",
		"test:fix-e2e": "node test/fix-e2e.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test:workflow-e2e": "node test/workflow-e2e.ts",
		"test:review-e2e": "node test/review-e2e.ts",
		"test:persona-e2e": "node test/persona-e2e.ts",
		"workflow": "node workflow/run.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@types/node": "^22.19.19",
		"typescript": "^5.9.3"
	}
}
