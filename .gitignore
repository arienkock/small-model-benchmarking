# llama.cpp release binaries / runtime files (never commit)
*.dll
*.exe
*.gguf
*.exp
*.lib
llama-verbose.txt
LICENSE-LLVM-OpenMP

# Benchmark run junk
**/node_modules/
**/__pycache__/
*.pyc
# pi's config dirs (auth.json, settings.json, models-store.json) -- but a workflow
# run's pi session transcripts are kept: they are the record of the run
**/.pi/*
!pi-small/workflow-runs/**/.pi/agent/
pi-small/workflow-runs/**/.pi/agent/*
!pi-small/workflow-runs/**/.pi/agent/sessions/
**/stderr.log
**/server_stderr.log
**/server-*.log
# only ignore lock files generated *inside* benchmark run outputs
# (a real lock file for the coding-bench tooling itself should stay committable)
coding-bench/bench-coding-*/**/package-lock.json
coding-bench/smoke-test/**/package-lock.json
benchmark*/**/package-lock.json
coding-bench/bench-filter-*/**/package-lock.json

# pi-small runtime junk
pi-small/.logs/
pi-small/.smoke-ws/
# every log the scripts produce: smoke.log, smoke-docker.log, build.log, ...
pi-small/*.log
# pi-small's own pi config dir (uncontained mode) -- sessions, trust
# decisions, and the seeded compaction settings; see bin/pi-small
pi-small/.pi-home/

# cache migration log (one-off, on the serving machine)
cache-move.log
pi-small/workspace/

# supervisor bake-off: intermediate probe jobs, raw per-command output (collected into
# out/probes.jsonl) and run logs; the verdicts, checklists and scores stay committed
pi-small/eval/supervisor/out/probe-jobs-*/
pi-small/eval/supervisor/out/probe-results/
pi-small/eval/supervisor/out/*.log

