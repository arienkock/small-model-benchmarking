    server.serve_forever()\\n\", \"path\": \"/work/server.py\"}"}}]}], "prompt_budget": {"estimated_prompt_tokens": 14080, "sections": {"system": 8759, "recent_messages": 1813, "run_brief": 240, "working_memory": 337, "fama_capsules": 0, "recovery_guidance": 21, "normalized_observations": 45, "fresh_tool_outputs": 0, "active_artifact_reads": 0, "turn_bundles": 0, "warm_briefs": 0, "episodic_summaries": 0, "artifact_snippets": 0, "warm_memories": 46, "user_attachments": 0, "knowledge_base_wrapper": 116, "mission_recap": 2970, "message_overhead": 31}, "section_limits": {}, "trimmed_sections": {}, "pruned_memory_sections": {}, "pruned_memory_reasons": {}, "dropped_summary_ids": [], "dropped_artifact_ids": [], "included_compaction_levels": ["L0"], "dropped_compaction_levels": [], "pressure_level": "", "message_count": 5, "max_prompt_tokens": 19712, "reserve_completion_tokens": 5120, "reserve_tool_tokens": 512, "compaction_estimated_prompt_tokens_before": 0, "compaction_estimated_prompt_tokens_after": 0, "compaction_threshold": 0, "compaction_recent_messages_before": 0, "compaction_recent_messages_after": 0, "compaction_keep_recent_initial": 0, "compaction_keep_recent_final": 0, "compaction_messages_compacted": 0, "compaction_attempt_count": 0, "compaction_stopped_reason": ""}}
