ttle a function to call at most maxPerWindow times per windowMs.\\n * Calls fn at most maxPerWindow times within windowMs milliseconds.\\n * Excess calls are silently skipped.\\n *\\n * @param fn - Function to throttle\\n * @param maxPerWindow - Maximum number of calls allowed per window\\n * @param windowMs - Window size in milliseconds\\n */\\nexport function throttle(fn: () => void, maxPerWindow: number, windowMs: number): () => void {\\n  let callCount = 0;\\n  let lastCallTime = 0;\\n\\n  return function () {\\n    const now = Date.now();\\n    const elapsed = now - lastCallTime;\\n\\n    // If window has passed, reset counters\\n    if (elapsed >= windowMs) {\\n      callCount = 0;\\n      lastCallTime = now;\\n    }\\n\\n    // Only call if we haven't reached the max per window\\n    if (callCount < maxPerWindow) {\\n      fn();\\n      callCount++;\\n    }\\n  };\\n}\\n\\n// Self-test when run directly\\nif (import.meta.url === new URL('.', import.meta.url).href) {\\n  // Test: call the function 7 times in a row, should only call fn 5 times\\n  let callsMade = 0;\\n  const throttled = throttle(() => { callsMade++; }, 5, 1000);\\n\\n  // Make 7 calls\\n  for (let i = 0; i < 7; i++) {\\n    throttled();\\n  }\\n\\n  assert.strictEqual(callsMade, 5, 'Should only call fn 5 times within the window');\\n  console.log('Self-test passed');\\n}\\n\", \"path\": \"throttle.ts\"}"}}]}], "prompt_budget": {"estimated_prompt_tokens": 14080, "sections": {"system": 8683, "recent_messages": 3903, "run_brief": 240, "working_memory": 337, "fama_capsules": 82, "recovery_guidance": 400, "normalized_observations": 51, "fresh_tool_outputs": 997, "active_artifact_reads": 567, "turn_bundles": 0, "warm_briefs": 0, "episodic_summaries": 0, "artifact_snippets": 0, "warm_memories": 0, "user_attachments": 0, "knowledge_base_wrapper": 116, "current_evidence_wrapper": 70, "mission_recap": 2970, "message_overhead": 191}, "section_limits": {}, "trimmed_sections": {}, "pruned_memory_sections":