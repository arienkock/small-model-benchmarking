that invokes `fn` at most `maxPerWindow`\n * times within any sliding window of `windowMs` milliseconds. Excess calls\n * are silently skipped.\n */\nexport function throttle<T extends (...args: never[]) => void>(\n  fn: T,\n  maxPerWindow: number,\n  windowMs: number\n): (...args: Parameters<T>) => void {\n  const calls: number[] = [];\n  const now = (): number => Date.now();\n\n  const throttled = (...args: Parameters<T>): void => {\n    const start = now();\n    const sinceLast = start - calls[calls.length - 1] ?? start;\n\n    if (calls.length === 0 || sinceLast >= windowMs) {\n      calls.push(start);\n      fn(...args);\n    }\n    // Otherwise: window still has enough room -> silently skip.\n  };\n\n  return throttled;\n}\n\n/**\n * Self-test: run with `node throttle.ts`.\n * Verifies that the wrapper calls fn at most maxPerWindow times per window.\n */\nfunction selfTest(): void {\n  let callCount = 0;\n  let lastCallAt = -Infinity;\n  let lastWindowStart = 0;\n\n  const fn = (): void => {\n    callCount++;\n    lastCallAt = Date.now();\n  };\n\n  const wrapped = throttle(fn, 3, 1000); // 3 calls per 1000ms\n\n  // First three calls should all fire.\n  wrapped();\n  wrapped();\n  wrapped();\n  assert.strictEqual(callCount, 3, 'first three calls should fire');\n\n  // Fourth call within the same window should be skipped.\n  wrapped();\n  assert.strictEqual(callCount, 3, 'fourth call within window should be skipped');\n\n  // Wait for the window to elapse, then a new call should fire again.\n  const waitStart = Date.now();\n  while (Date.now() - waitStart < 1000) {\n    /* busy-wait */\n  }\n\n  wrapped();\n  assert.strictEqual(callCount, 4, 'call after window reset should fire');\n\n  console.log('all tests passed');\n}\n\n// Run self-test when executed directly.\nif (import.meta.url === pathToFileURL(process.argv[1]).href) {\n  selfTest();\n}\n\nYou now have 74 lines from `/work/throttle.ts`. Do not call `file_read` on the same path again in this repair cycl